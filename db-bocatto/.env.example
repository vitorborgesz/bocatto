# Bocatto — variáveis de ambiente (fonte única)
#
# Copie para .env nesta pasta e ajuste:  cp .env.example .env
# O .env NUNCA vai para o Git (está no .gitignore). Este arquivo é o "contrato":
# diz quais variáveis existem, sem conter segredos reais.
#
# Quem lê o .env desta pasta:
#   - o docker-compose.yaml (banco, API e front no Docker);
#   - a API rodando fora do Docker (npm run dev em api-bocatto/).
# O front fora do Docker usa front-bocatto/.env.local (veja o .env.example de lá).

# --- Banco de dados (PostgreSQL) ---
# Usados pelo serviço "db" para criar o banco na primeira subida do volume
# e pela API para se conectar.
# Atenção: se o volume bocatto_pgdata já existir, mudar estes valores NÃO
# altera o banco já criado.
POSTGRES_USER=bocatto
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=bocatto

# Onde a API encontra o banco quando roda FORA do Docker.
# No Docker, o docker-compose.yaml sobrescreve para db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- API ---
# Porta da API fora do Docker (no Docker é sempre 3333).
PORT=3333
# Chave que assina os tokens JWT. Mínimo de 32 caracteres: a API NÃO sobe
# com o valor abaixo (de propósito). Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=TROQUE-POR-UMA-CHAVE-GERADA
# Validade do token (formato do jsonwebtoken: 30m, 8h, 1d...).
JWT_EXPIRES_IN=8h
# Taxa de entrega fixa (em reais) somada a todo pedido.
TAXA_ENTREGA=5.00
# Front-ends autorizados a chamar a API pelo navegador, separados por vírgula.
CORS_ORIGINS=http://localhost:3000

# --- Dados de demonstração (npm run db:seed) ---
# Senha de todas as contas criadas pelo seed (mínimo 8 caracteres).
SEED_SENHA=troque-esta-senha-demo

# --- Front-end (no Docker) ---
# Endereço da API usado pelo navegador.
NEXT_PUBLIC_API_URL=http://localhost:3333
