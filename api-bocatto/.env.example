# Bocatto API — variáveis de ambiente (rodando local, sem Docker)
#
# Copie para .env nesta pasta e preencha:  cp .env.example .env
# O .env NUNCA vai para o Git (está no .gitignore). Este arquivo é o "contrato":
# diz quais variáveis existem, sem conter segredos reais.

# --- Banco de dados (PostgreSQL local) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Nome do banco criado para o Bocatto (veja docs/CONFIGURACAO_BANCO.md).
POSTGRES_DATABASE=db-bocatto
# Usuário do PostgreSQL e a senha dele (neste projeto: o administrador postgres).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# --- API ---
PORT=4444
# Chave que assina os tokens JWT. Mínimo de 32 caracteres: a API NÃO sobe
# com o valor abaixo (de propósito). Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=TROQUE-POR-UMA-CHAVE-GERADA
# Validade do token (formato do jsonwebtoken: 30m, 8h, 1d...).
JWT_EXPIRES_IN=8h
# Taxa de entrega fixa (em reais) somada a todo pedido.
TAXA_ENTREGA=5.00
# Front-ends autorizados a chamar a API pelo navegador, separados por vírgula.
CORS_ORIGINS=http://localhost:4100

# --- Dados de demonstração (npm run db:seed) ---
# Senha das contas admin@bocatto.com e cliente@bocatto.com (mínimo 8 caracteres).
SEED_SENHA=troque-esta-senha-demo
