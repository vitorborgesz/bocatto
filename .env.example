# Bocatto — variáveis de ambiente
#
# Copie para .env e ajuste:  cp .env.example .env
# O .env NUNCA vai para o Git (está no .gitignore). Este arquivo é o "contrato":
# diz quais variáveis existem, sem conter segredos reais.

# --- Banco de dados (PostgreSQL) ---
# Usados pelo serviço "db" para criar o banco na primeira subida do volume e
# pelo serviço "api" para montar a DATABASE_URL (veja docker-compose.yml).
# Atenção: se o volume bocatto_pgdata já existir, mudar estes valores NÃO
# altera o banco já criado.
# Evite o caractere "%" na senha: ele quebra a leitura da URL pelo Alembic.
POSTGRES_USER=bocatto
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=bocatto

# --- Autenticação (JWT) ---
# Gere a sua com:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo de 32 caracteres: a API NÃO sobe com o valor abaixo (de propósito).
SECRET_KEY=TROQUE-POR-UMA-CHAVE-GERADA
# Validade do token em minutos (1 a 1440).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Front-ends autorizados a chamar a API pelo navegador (formato JSON).
# 5173 é a porta padrão do servidor de desenvolvimento do Vite.
CORS_ORIGINS=["http://localhost:5173"]

# DATABASE_URL não precisa ser definida aqui: o docker-compose.yml a monta a
# partir das variáveis POSTGRES_* acima.
